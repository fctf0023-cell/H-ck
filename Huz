<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Axiom Game Menu</title>

<style>
    * {
        box-sizing: border-box;
        user-select: none;
        font-family: Arial, sans-serif;
    }

    body {
        margin: 0;
        height: 100vh;
        overflow: hidden;
        background:
            radial-gradient(circle at center, #20252b 0%, #0d0f12 70%);
        color: white;
    }

    /* Nút mở menu */
    #openButton {
        position: fixed;
        top: 30px;
        left: 30px;

        width: 58px;
        height: 58px;
        border-radius: 50%;

        border: 2px solid #5cff75;
        background: #101510;

        color: #5cff75;
        font-size: 24px;
        cursor: pointer;

        box-shadow: 0 0 20px #3cff5c66;
        transition: .2s;
        z-index: 1000;
    }

    #openButton:hover {
        transform: scale(1.08);
        box-shadow: 0 0 30px #3cff5c99;
    }

    /* Menu */
    #menu {
        position: fixed;
        top: 100px;
        left: 30px;

        width: 330px;
        padding: 20px;

        background: rgba(12,15,18,.94);
        border: 1px solid #3b444d;
        border-radius: 14px;

        box-shadow: 0 20px 70px #000b;
        backdrop-filter: blur(12px);

        transform: scale(.85);
        opacity: 0;
        pointer-events: none;

        transition: .2s ease;
        z-index: 999;
    }

    #menu.visible {
        transform: scale(1);
        opacity: 1;
        pointer-events: auto;
    }

    .title {
        display: flex;
        justify-content: space-between;
        align-items: center;

        margin-bottom: 18px;
        padding-bottom: 12px;

        border-bottom: 1px solid #333b43;
    }

    .title strong {
        font-size: 20px;
    }

    .status {
        color: #5cff75;
        font-size: 11px;
    }

    .feature {
        margin: 12px 0;
        padding: 12px;

        background: #171b20;
        border-radius: 10px;
        border: 1px solid #242b32;
    }

    .featureHeader {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .featureName {
        font-weight: bold;
    }

    .description {
        margin-top: 6px;
        color: #87919b;
        font-size: 11px;
    }

    /* Toggle */
    .toggle {
        width: 42px;
        height: 22px;
        background: #303840;
        border-radius: 20px;
        position: relative;
        cursor: pointer;
        transition: .2s;
    }

    .toggle::after {
        content: "";
        position: absolute;

        width: 18px;
        height: 18px;

        top: 2px;
        left: 2px;

        background: white;
        border-radius: 50%;

        transition: .2s;
    }

    .toggle.active {
        background: #39d95b;
    }

    .toggle.active::after {
        left: 22px;
    }

    /* Slider */
    .sliderRow {
        margin-top: 10px;
    }

    input[type="range"] {
        width: 100%;
        accent-color: #5cff75;
        cursor: pointer;
    }

    .value {
        color: #5cff75;
        font-size: 12px;
        float: right;
    }

    /* Fake game world */
    #world {
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    .player {
        position: absolute;
        width: 35px;
        height: 60px;

        background: #53606b;
        border-radius: 5px;

        transition:
            left .4s linear,
            top .4s linear;
    }

    .player::before {
        content: "";
        position: absolute;

        width: 24px;
        height: 24px;

        left: 5px;
        top: -28px;

        border-radius: 50%;
        background: #727f89;
    }

    /* ESP */
    .espBox {
        position: absolute;
        inset: -8px;

        border: 2px solid #35ff62;
        pointer-events: none;

        display: none;
    }

    .espInfo {
        position: absolute;

        left: 45px;
        top: -10px;

        width: max-content;

        padding: 6px 9px;

        background: rgba(0,0,0,.75);
        border-left: 2px solid #35ff62;

        color: #5cff75;
        font-size: 12px;

        display: none;
    }

    .espDistance {
        color: #ddd;
    }

    .player.esp .espBox,
    .player.esp .espInfo {
        display: block;
    }

    /* X-ray visual simulation */
    body.xray .player {
        opacity: .25;
        filter: brightness(1.8);
    }

    body.xray .player::after {
        content: "X-RAY";
        position: absolute;
        top: -45px;
        left: -2px;

        color: #ffff66;
        font-size: 10px;
    }

    /* Fake projectile */
    #projectile {
        position: fixed;

        width: 10px;
        height: 10px;

        background: #fff;
        border-radius: 50%;

        box-shadow:
            0 0 10px #fff,
            0 0 25px #ffea5c;

        display: none;
        z-index: 100;
    }

    #notification {
        position: fixed;
        bottom: 30px;
        left: 50%;

        transform: translateX(-50%) translateY(20px);

        background: #15191d;
        border: 1px solid #384149;
        border-radius: 8px;

        padding: 10px 16px;

        font-size: 12px;
        opacity: 0;

        transition: .25s;
    }

    #notification.show {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
    }
</style>
</head>

<body>

<button id="openButton">☰</button>

<div id="menu">

    <div class="title">
        <strong>AXIOM MENU</strong>
        <span class="status">● ONLINE</span>
    </div>

    <!-- ESP -->
    <div class="feature">
        <div class="featureHeader">
            <span class="featureName">ESP</span>
            <div class="toggle" data-feature="esp"></div>
        </div>

        <div class="description">
            Hiển thị người chơi mô phỏng, tên, máu và khoảng cách.
        </div>
    </div>

    <!-- SPEED -->
    <div class="feature">
        <div class="featureHeader">
            <span class="featureName">Tốc độ</span>
            <span class="value" id="speedValue">10</span>
        </div>

        <div class="sliderRow">
            <input
                id="speed"
                type="range"
                min="1"
                max="100"
                value="10">
        </div>
    </div>

    <!-- JUMP -->
    <div class="feature">
        <div class="featureHeader">
            <span class="featureName">Nhảy cao</span>
            <span class="value" id="jumpValue">10</span>
        </div>

        <div class="sliderRow">
            <input
                id="jump"
                type="range"
                min="1"
                max="100"
                value="10">
        </div>
    </div>

    <!-- FO -->
    <div class="feature">
        <div class="featureHeader">
            <span class="featureName">FO</span>
            <div class="toggle" data-feature="fo"></div>
        </div>

        <div class="description">
            Mô phỏng viên đạn tự chọn mục tiêu gần nhất.
        </div>
    </div>

    <!-- XRAY -->
    <div class="feature">
        <div class="featureHeader">
            <span class="featureName">X-ray</span>
            <div class="toggle" data-feature="xray"></div>
        </div>

        <div class="description">
            Chế độ hiển thị xuyên vật thể trong bản mô phỏng.
        </div>
    </div>

</div>

<div id="world">

    <div class="player" id="p1" style="left:65%;top:30%;">
        <div class="espBox"></div>
        <div class="espInfo">
            Player_01<br>
            ❤️ 100 HP<br>
            <span class="espDistance">Khoảng cách: 42m</span>
        </div>
    </div>

    <div class="player" id="p2" style="left:35%;top:60%;">
        <div class="espBox"></div>
        <div class="espInfo">
            Player_02<br>
            ❤️ 76 HP<br>
            <span class="espDistance">Khoảng cách: 27m</span>
        </div>
    </div>

    <div class="player" id="p3" style="left:78%;top:70%;">
        <div class="espBox"></div>
        <div class="espInfo">
            Player_03<br>
            ❤️ 91 HP<br>
            <span class="espDistance">Khoảng cách: 63m</span>
        </div>
    </div>

</div>

<div id="projectile"></div>
<div id="notification"></div>

<script>
"use strict";

/* ==============================
   AXIOM MENU CORE
============================== */

const state = {
    menuOpen: false,
    esp: false,
    fo: false,
    xray: false,
    speed: 10,
    jump: 10
};

const menu = document.getElementById("menu");
const openButton = document.getElementById("openButton");
const notification = document.getElementById("notification");

function notify(message) {
    notification.textContent = message;
    notification.classList.add("show");

    clearTimeout(notify.timer);

    notify.timer = setTimeout(() => {
        notification.classList.remove("show");
    }, 1500);
}

/* ==============================
   MENU OPEN / CLOSE
============================== */

function toggleMenu(force = null) {
    state.menuOpen =
        force === null
            ? !state.menuOpen
            : force;

    menu.classList.toggle(
        "visible",
        state.menuOpen
    );
}

openButton.addEventListener("click", () => {
    toggleMenu();
});

/* Minecraft-style key toggle */
document.addEventListener("keydown", event => {

    if (event.code === "Insert") {
        toggleMenu();
    }

    if (event.code === "Escape") {
        toggleMenu(false);
    }
});

/* ==============================
   FEATURE TOGGLES
============================== */

document.querySelectorAll(".toggle").forEach(toggle => {

    toggle.addEventListener("click", () => {

        const feature =
            toggle.dataset.feature;

        state[feature] =
            !state[feature];

        toggle.classList.toggle(
            "active",
            state[feature]
        );

        updateFeature(feature);
    });
});

function updateFeature(feature) {

    switch (feature) {

        case "esp":
            document
                .querySelectorAll(".player")
                .forEach(player => {
                    player.classList.toggle(
                        "esp",
                        state.esp
                    );
                });

            notify(
                `ESP ${state.esp ? "BẬT" : "TẮT"}`
            );
            break;

        case "xray":
            document.body.classList.toggle(
                "xray",
                state.xray
            );

            notify(
                `X-ray ${state.xray ? "BẬT" : "TẮT"}`
            );
            break;

        case "fo":
            notify(
                `FO ${state.fo ? "BẬT" : "TẮT"}`
            );
            break;
    }
}

/* ==============================
   SPEED SLIDER
============================== */

const speedSlider =
    document.getElementById("speed");

const speedValue =
    document.getElementById("speedValue");

speedSlider.addEventListener("input", event => {

    state.speed =
        Number(event.target.value);

    speedValue.textContent =
        state.speed;

    notify(
        `Tốc độ: ${state.speed}`
    );
});

/* ==============================
   JUMP SLIDER
============================== */

const jumpSlider =
    document.getElementById("jump");

const jumpValue =
    document.getElementById("jumpValue");

jumpSlider.addEventListener("input", event => {

    state.jump =
        Number(event.target.value);

    jumpValue.textContent =
        state.jump;

    notify(
        `Nhảy cao: ${state.jump}`
    );
});

/* ==============================
   FAKE FO TARGET SYSTEM
   Chỉ mô phỏng trong giao diện.
============================== */

function distance(a, b) {

    const dx = a.x - b.x;
    const dy = a.y - b.y;

    return Math.sqrt(
        dx * dx + dy * dy
    );
}

function findNearestDemoPlayer() {

    const center = {
        x: window.innerWidth / 2,
        y: window.innerHeight / 2
    };

    const players =
        [...document.querySelectorAll(".player")];

    let nearest = null;
    let nearestDistance = Infinity;

    players.forEach(player => {

        const rect =
            player.getBoundingClientRect();

        const point = {
            x: rect.left,
            y: rect.top
        };

        const d =
            distance(center, point);

        if (d < nearestDistance) {
            nearestDistance = d;
            nearest = player;
        }
    });

    return nearest;
}

/*
 * Click chuột mô phỏng bắn.
 * Không kết nối tới game hoặc người chơi thật.
 */
document.addEventListener("mousedown", event => {

    if (!state.fo)
        return;

    if (event.button !== 0)
        return;

    const target =
        findNearestDemoPlayer();

    if (!target)
        return;

    fireDemoProjectile(target);
});

function fireDemoProjectile(target) {

    const projectile =
        document.getElementById("projectile");

    const targetRect =
        target.getBoundingClientRect();

    const startX =
        window.innerWidth / 2;

    const startY =
        window.innerHeight / 2;

    const endX =
        targetRect.left +
        targetRect.width / 2;

    const endY =
        targetRect.top +
        targetRect.height / 2;

    projectile.style.left =
        `${startX}px`;

    projectile.style.top =
        `${startY}px`;

    projectile.style.display =
        "block";

    projectile.animate(
        [
            {
                left: `${startX}px`,
                top: `${startY}px`
            },
            {
                left: `${endX}px`,
                top: `${endY}px`
            }
        ],
        {
            duration: 350,
            easing: "ease-out"
        }
    );

    setTimeout(() => {
        projectile.style.display = "none";
    }, 350);

    notify(
        `FO → mục tiêu gần nhất: ${target.id}`
    );
}

/* ==============================
   RESPONSIVE MENU
============================== */

window.addEventListener("resize", () => {

    if (window.innerWidth < 500) {
        menu.style.width =
            "calc(100vw - 60px)";
    } else {
        menu.style.width =
            "330px";
    }
});

/* ==============================
   INITIALIZATION
============================== */

function initialize() {

    menu.classList.remove("visible");

    document
        .querySelectorAll(".toggle")
        .forEach(toggle => {
            toggle.classList.remove("active");
        });

    document
        .querySelectorAll(".player")
        .forEach(player => {
            player.classList.remove("esp");
        });
}

initialize();
</script>

</body>
</html>
